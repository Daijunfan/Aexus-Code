			},
			{
				"id": "aexus-pi",
				"name": "pi",
				"fullName": "Pi",
				"description": "%piDescription%",
				"commands": [
					{ "name": "compact", "description": "%cmdCompact%" },
					{ "name": "tree", "description": "Show the conversation tree" },
					{ "name": "fork", "description": "Fork the current conversation into a new branch" },
					{ "name": "new", "description": "%cmdNew%" },
					{ "name": "clear", "description": "%cmdClear%" },
					{ "name": "model", "description": "%cmdModel%" },
					{ "name": "thinking", "description": "Set the thinking level" },
					{ "name": "stats", "description": "Show session statistics" },
					{ "name": "reload", "description": "Reload settings and skills" },
					{ "name": "skills", "description": "%cmdSkills%" },
					{ "name": "help", "description": "%cmdHelp%" }
				]
			}
		],
		"configuration": {
			"title": "ADE",
			"properties": {
				"aexus.ade.cliPaths": {
					"type": "object",
					"default": {},
					"scope": "machine",
					"description": "%cliPathsDescription%",
					"properties": {
						"codex": { "type": "string" },
						"claude": { "type": "string" },
						"kilo": { "type": "string" },
						"opencode": { "type": "string" },
						"dsh": { "type": "string" },
						"agy": { "type": "string" },
						"antigravity": { "type": "string" },
						"cline": { "type": "string" },
						"pi": { "type": "string" }
					},
					"additionalProperties": false
				},
				"aexus.ade.remoteCliPaths": {
					"type": "object",
					"default": {},
					"scope": "application",
					"description": "Optional per-Cloud-Host Coding Agent CLI binary path overrides, keyed by SSH host alias (e.g. { \"ubuntu-target1\": { \"claude\": \"/opt/bin/claude\" } }).",
					"additionalProperties": {
						"type": "object",
						"additionalProperties": { "type": "string" }
					}
				},
				"aexus.ade.turnTimeoutMs": {
					"type": "number",
					"default": 900000,
					"minimum": 30000,
					"scope": "application",
					"description": "Hard per-turn execution deadline in milliseconds (default 900000 = 15 minutes; minimum 30000)."
				},
				"aexus.ade.idleStallTimeoutMs": {
					"type": "number",
					"default": 180000,
					"minimum": 0,
					"scope": "application",
					"description": "Sliding stream-inactivity stall timeout in milliseconds (default 180000 = 3 minutes; set 0 to disable)."
				}
			}
		}
	},
	"scripts": {
		"compile": "../../node_modules/.bin/tsc -p ./tsconfig.json --noEmit && node ./esbuild.mts",
		"typecheck": "../../node_modules/.bin/tsc -p ./tsconfig.json --noEmit",
		"esbuild": "node ./esbuild.mts",
		"test": "node --test test/*.test.ts"
	}
}
