{
	"name": "aexus-agents",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": { "vscode": "^1.146.0" },
	"main": "./dist/extension.js",
	"extensionKind": ["ui"],
	"activationEvents": ["*"],
	"enabledApiProposals": ["chatSessionsProvider", "chatParticipantPrivate"],
	"capabilities": { "virtualWorkspaces": true, "untrustedWorkspaces": { "supported": true } },
	"contributes": {
		"chatSessions": [
			{ "type": "aexus-secretary", "name": "secretary", "displayName": "Secretary", "description": "%secretaryDescription%", "icon": { "light": "resources/aexus-icon.svg", "dark": "resources/aexus-icon.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "hideFromSessionTypePicker": true },
			{ "type": "aexus-codex", "name": "codex", "displayName": "Codex", "description": "%codexDescription%", "icon": "$(openai)", "requiresCopilotSignIn": false, "supportsAutoModel": true, "hideFromSessionTypePicker": true },
			{ "type": "aexus-claude", "name": "claude", "displayName": "Claude Code", "description": "%claudeDescription%", "icon": "$(claude)", "requiresCopilotSignIn": false, "supportsAutoModel": true, "hideFromSessionTypePicker": true },
			{ "type": "aexus-kilo", "name": "kilo", "displayName": "Kilo Code", "description": "%kiloDescription%", "icon": { "light": "resources/kilo-light.svg", "dark": "resources/kilo-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "hideFromSessionTypePicker": true },
			{ "type": "aexus-opencode", "name": "opencode", "displayName": "OpenCode", "description": "%opencodeDescription%", "icon": { "light": "resources/opencode-light.svg", "dark": "resources/opencode-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "hideFromSessionTypePicker": true },
			{ "type": "aexus-dsh", "name": "dsh", "displayName": "DeepSeek Harness", "description": "%dshDescription%", "icon": { "light": "resources/dsh-light.svg", "dark": "resources/dsh-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "hideFromSessionTypePicker": true },
			{ "type": "aexus-antigravity", "name": "antigravity", "displayName": "Google Antigravity", "description": "%antigravityDescription%", "icon": { "light": "resources/antigravity-light.svg", "dark": "resources/antigravity-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "hideFromSessionTypePicker": true },
			{ "type": "aexus-cline", "name": "cline", "displayName": "Cline", "description": "%clineDescription%", "icon": { "light": "resources/cline-light.svg", "dark": "resources/cline-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "hideFromSessionTypePicker": true },
			{ "type": "aexus-pi", "name": "pi", "displayName": "Pi", "description": "%piDescription%", "icon": { "light": "resources/pi-light.svg", "dark": "resources/pi-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "hideFromSessionTypePicker": true }
