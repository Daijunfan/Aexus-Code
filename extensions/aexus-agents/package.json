{
	"name": "aexus-agents",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "2.0.0",
	"publisher": "aexus",
	"license": "MIT",
	"l10n": "./l10n",
	"engines": { "vscode": "^1.146.0" },
	"main": "./dist/extension.js",
	"extensionKind": ["ui"],
	"activationEvents": ["*"],
	"enabledApiProposals": ["chatSessionsProvider", "chatParticipantPrivate", "chatParticipantAdditions", "chatSessionCustomizationProvider"],
	"capabilities": { "virtualWorkspaces": true, "untrustedWorkspaces": { "supported": true } },
	"contributes": {
		"chatSessions": [
			{ "type": "aexus-codex", "name": "codex", "displayName": "Codex", "description": "%codexDescription%", "icon": { "light": "resources/codex-light.svg", "dark": "resources/codex-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "supportsPromptAttachments": true, "capabilities": { "supportsPromptAttachments": true, "supportsFileAttachments": true, "supportsImageAttachments": true }, "hideFromSessionTypePicker": true },
			{ "type": "aexus-claude", "name": "claude", "displayName": "Claude Code", "description": "%claudeDescription%", "icon": { "light": "resources/claude-light.svg", "dark": "resources/claude-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "supportsPromptAttachments": true, "capabilities": { "supportsPromptAttachments": true, "supportsFileAttachments": true, "supportsImageAttachments": true }, "hideFromSessionTypePicker": true },
			{ "type": "aexus-kilo", "name": "kilo", "displayName": "Kilo Code", "description": "%kiloDescription%", "icon": { "light": "resources/kilo-light.svg", "dark": "resources/kilo-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "supportsPromptAttachments": true, "capabilities": { "supportsPromptAttachments": true, "supportsFileAttachments": true, "supportsImageAttachments": true }, "hideFromSessionTypePicker": true },
			{ "type": "aexus-opencode", "name": "opencode", "displayName": "OpenCode", "description": "%opencodeDescription%", "icon": { "light": "resources/opencode-light.svg", "dark": "resources/opencode-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "supportsPromptAttachments": true, "capabilities": { "supportsPromptAttachments": true, "supportsFileAttachments": true, "supportsImageAttachments": true }, "hideFromSessionTypePicker": true },
			{ "type": "aexus-dsh", "name": "dsh", "displayName": "DeepSeek Harness", "description": "%dshDescription%", "icon": { "light": "resources/dsh-light.svg", "dark": "resources/dsh-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "supportsPromptAttachments": true, "capabilities": { "supportsPromptAttachments": true, "supportsFileAttachments": true, "supportsImageAttachments": true }, "hideFromSessionTypePicker": true },
			{ "type": "aexus-antigravity", "name": "antigravity", "displayName": "Google Antigravity", "description": "%antigravityDescription%", "icon": { "light": "resources/antigravity-light.svg", "dark": "resources/antigravity-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "supportsPromptAttachments": true, "capabilities": { "supportsPromptAttachments": true, "supportsFileAttachments": true, "supportsImageAttachments": true }, "hideFromSessionTypePicker": true },
			{ "type": "aexus-cline", "name": "cline", "displayName": "Cline", "description": "%clineDescription%", "icon": { "light": "resources/cline-light.svg", "dark": "resources/cline-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "supportsPromptAttachments": true, "capabilities": { "supportsPromptAttachments": true, "supportsFileAttachments": true, "supportsImageAttachments": true }, "hideFromSessionTypePicker": true },
			{ "type": "aexus-pi", "name": "pi", "displayName": "Pi", "description": "%piDescription%", "icon": { "light": "resources/pi-light.svg", "dark": "resources/pi-dark.svg" }, "requiresCopilotSignIn": false, "supportsAutoModel": true, "supportsPromptAttachments": true, "capabilities": { "supportsPromptAttachments": true, "supportsFileAttachments": true, "supportsImageAttachments": true }, "hideFromSessionTypePicker": true }
		],
		"chatParticipants": [
			{
				"id": "aexus-codex",
				"name": "codex",
				"fullName": "Codex",
				"description": "%codexDescription%",
				"commands": [
					{ "name": "compact", "description": "%cmdCompact%" },
					{ "name": "fork", "description": "Fork the current conversation into a new branch" },
					{ "name": "plan", "description": "%cmdPlan%" },
					{ "name": "clear", "description": "%cmdClear%" },
					{ "name": "model", "description": "%cmdModel%" },
					{ "name": "effort", "description": "Set the reasoning effort level" },
					{ "name": "permissions", "description": "Configure approval behavior" },
					{ "name": "sandbox", "description": "Configure the sandbox policy" },
					{ "name": "search", "description": "Toggle web search policy" },
					{ "name": "mcp", "description": "%cmdMcp%" },
					{ "name": "diff", "description": "%cmdDiff%" },
					{ "name": "skills", "description": "%cmdSkills%" },
					{ "name": "help", "description": "%cmdHelp%" }
				]
			},
			{
				"id": "aexus-claude",
				"name": "claude",
				"fullName": "Claude Code",
				"description": "%claudeDescription%",
				"commands": [
					{ "name": "compact", "description": "%cmdCompact%" },
					{ "name": "plan", "description": "%cmdPlan%" },
					{ "name": "clear", "description": "%cmdClear%" },
					{ "name": "model", "description": "%cmdModel%" },
					{ "name": "effort", "description": "Set the reasoning effort level" },
					{ "name": "permissions", "description": "Configure tool permissions" },
					{ "name": "mcp", "description": "%cmdMcp%" },
					{ "name": "memory", "description": "%cmdMemory%" },
					{ "name": "cost", "description": "%cmdCost%" },
					{ "name": "context", "description": "Show context window usage" },
					{ "name": "doctor", "description": "%cmdDoctor%" },
					{ "name": "diff", "description": "%cmdDiff%" },
					{ "name": "usage", "description": "Show plan usage limits" },
					{ "name": "config", "description": "Open the configuration UI" },
					{ "name": "skills", "description": "%cmdSkills%" },
					{ "name": "help", "description": "%cmdHelp%" }
				]
			},
			{
				"id": "aexus-kilo",
				"name": "kilo",
				"fullName": "Kilo Code",
				"description": "%kiloDescription%",
				"commands": [
					{ "name": "compact", "description": "%cmdCompact%" },
					{ "name": "undo", "description": "Undo the last change" },
					{ "name": "redo", "description": "Redo the last undone change" },
					{ "name": "share", "description": "Share the current conversation" },
					{ "name": "unshare", "description": "Stop sharing the current conversation" },
					{ "name": "mode", "description": "Switch the Kilo mode" },
					{ "name": "model", "description": "%cmdModel%" },
					{ "name": "thinking", "description": "Set the thinking level" },
					{ "name": "mcp", "description": "%cmdMcp%" },
					{ "name": "clear", "description": "%cmdClear%" },
					{ "name": "diff", "description": "%cmdDiff%" },
					{ "name": "skills", "description": "%cmdSkills%" },
					{ "name": "help", "description": "%cmdHelp%" }
				]
			},
			{
				"id": "aexus-opencode",
				"name": "opencode",
				"fullName": "OpenCode",
				"description": "%opencodeDescription%",
				"commands": [
					{ "name": "compact", "description": "%cmdCompact%" },
					{ "name": "undo", "description": "Undo the last change" },
					{ "name": "redo", "description": "Redo the last undone change" },
					{ "name": "share", "description": "Share the current conversation" },
					{ "name": "unshare", "description": "Stop sharing the current conversation" },
					{ "name": "agent", "description": "Switch the active OpenCode agent" },
					{ "name": "model", "description": "%cmdModel%" },
					{ "name": "thinking", "description": "Set the thinking level" },
					{ "name": "mcp", "description": "%cmdMcp%" },
					{ "name": "clear", "description": "%cmdClear%" },
					{ "name": "diff", "description": "%cmdDiff%" },
					{ "name": "skills", "description": "%cmdSkills%" },
					{ "name": "help", "description": "%cmdHelp%" }
				]
			},
			{
				"id": "aexus-dsh",
				"name": "dsh",
				"fullName": "DeepSeek Harness",
				"description": "%dshDescription%",
				"commands": [
					{ "name": "compact", "description": "%cmdCompact%" },
					{ "name": "plan", "description": "%cmdPlan%" },
					{ "name": "mode", "description": "Switch the DeepSeek Harness mode" },
					{ "name": "model", "description": "%cmdModel%" },
					{ "name": "thinking", "description": "Set the thinking level" },
					{ "name": "permissions", "description": "Configure the permission policy" },
					{ "name": "clear", "description": "%cmdClear%" },
					{ "name": "diff", "description": "%cmdDiff%" },
					{ "name": "skills", "description": "%cmdSkills%" },
					{ "name": "help", "description": "%cmdHelp%" }
				]
			},
			{
				"id": "aexus-antigravity",
				"name": "antigravity",
				"fullName": "Google Antigravity",
				"description": "%antigravityDescription%",
				"commands": [
					{ "name": "plan", "description": "%cmdPlan%" },
					{ "name": "compact", "description": "%cmdCompact%" },
					{ "name": "model", "description": "%cmdModel%" },
					{ "name": "mode", "description": "Switch the Antigravity mode" },
					{ "name": "mcp", "description": "%cmdMcp%" },
					{ "name": "clear", "description": "%cmdClear%" },
					{ "name": "diff", "description": "%cmdDiff%" },
					{ "name": "skills", "description": "%cmdSkills%" },
					{ "name": "help", "description": "%cmdHelp%" }
				]
			},
			{
				"id": "aexus-cline",
				"name": "cline",
				"fullName": "Cline",
				"description": "%clineDescription%",
				"commands": [
					{ "name": "newtask", "description": "Start a new task" },
					{ "name": "smol", "description": "Condense the conversation to a smaller context" },
					{ "name": "compact", "description": "%cmdCompact%" },
					{ "name": "plan", "description": "%cmdPlan%" },
					{ "name": "act", "description": "Switch to act mode" },
					{ "name": "undo", "description": "Undo the last change" },
					{ "name": "fork", "description": "Fork the current conversation into a new task" },
					{ "name": "model", "description": "%cmdModel%" },
					{ "name": "thinking", "description": "Set the thinking level" },
					{ "name": "mcp", "description": "%cmdMcp%" },
					{ "name": "clear", "description": "%cmdClear%" },
					{ "name": "diff", "description": "%cmdDiff%" },
					{ "name": "skills", "description": "%cmdSkills%" },
					{ "name": "help", "description": "%cmdHelp%" }
