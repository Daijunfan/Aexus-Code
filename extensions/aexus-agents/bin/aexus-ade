#!/usr/bin/env sh
set -e

SOURCE="$0"
while [ -L "$SOURCE" ]; do
	DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
	SOURCE=$(readlink "$SOURCE")
	case "$SOURCE" in
		/*) ;;
		*) SOURCE="$DIR/$SOURCE" ;;
	esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
CLI_JS="$BIN_DIR/../dist/adeCli.js"
if [ ! -f "$CLI_JS" ] && [ -f "$BIN_DIR/../extensions/aexus-agents/dist/adeCli.js" ]; then
	CLI_JS="$BIN_DIR/../extensions/aexus-agents/dist/adeCli.js"
fi

if command -v node >/dev/null 2>&1; then
	exec node "$CLI_JS" "$@"
fi

if [ -n "$VSCODE_EXEC_PATH" ] && [ -x "$VSCODE_EXEC_PATH" ]; then
	ELECTRON_RUN_AS_NODE=1 exec "$VSCODE_EXEC_PATH" "$CLI_JS" "$@"
fi

for CANDIDATE in \
	"/Applications/Aexus Code.app/Contents/MacOS/Aexus Code" \
	"/Applications/Aexus Code.app/Contents/MacOS/Electron" \
	"$BIN_DIR/../../../MacOS/Aexus Code" \
	"$BIN_DIR/../../../MacOS/Electron" \
	"$BIN_DIR/../../../../../MacOS/Aexus Code" \
	"$BIN_DIR/../../../../../MacOS/Electron" \
	"$BIN_DIR/../Aexus Code.exe" \
	"$BIN_DIR/../../../../../Aexus Code.exe" \
	"$BIN_DIR/../aexus-code" \
	"$BIN_DIR/../../../../../aexus-code" \
	"/usr/share/aexus-code/aexus-code" \
	"/opt/Aexus Code/aexus-code" \
	"${LOCALAPPDATA:+$LOCALAPPDATA/Programs/Aexus Code/Aexus Code.exe}" \
	"$BIN_DIR/../../.build/electron/Aexus Code.app/Contents/MacOS/Aexus Code" \
	"$BIN_DIR/../../.build/electron/Code - OSS.app/Contents/MacOS/Electron" \
	"$BIN_DIR/../../../.build/electron/Aexus Code.exe" \
	"$BIN_DIR/../../../.build/electron/aexus-code"
do
	if [ -n "$CANDIDATE" ] && [ -x "$CANDIDATE" ]; then
		VSCODE_DEV= ELECTRON_RUN_AS_NODE=1 exec "$CANDIDATE" "$CLI_JS" "$@"
	fi
done

echo "aexus-ade: unable to locate node or Aexus Code runtime." >&2
exit 1
